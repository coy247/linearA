; ============================================================
; voynich — booLang IR formalization of SHA-256 double-hash
; ============================================================
;
; This file expresses the midstate dsha256 mining kernel as a
; booLang IR artifact. Every construct here satisfies the IR
; skeleton's design invariants:
;
;   ✓ All constructs reduce to: boolean operators, finite state
;     tags, static tables
;   ✓ No construct depends on: time, phase, runtime interpretation
;   ✓ No construct introduces: weighting, authority, amplification,
;     feedback, leverage
;   ✓ Determinism rule: identical inputs → identical outputs
;   ✓ Temporal exclusion: time is not an input
;   ✓ Forbidden constructs absent: no loops*, no recursion, no
;     counters, no accumulators, no clocks, no floating-point,
;     no dynamic allocation, no self-modifying structures
;
;   *The 64-round compression is expressed as 64 static stages,
;    not a loop. Each stage is a deterministic function of the
;    previous stage's output. The unrolled form is finite and
;    enumerable.
;
; Domain extension: IR_V0 operates on {u, !u}. voynich extends
; the domain to W32 — 32-bit words — as a product of 32 boolean
; lanes. Every W32 operation decomposes to 32 parallel boolean
; operations. This preserves boolean-first semantics while
; enabling word-width machine code emission.
;
; References:
;   IR skeleton:  docs/BOOLANG_IR_SKELETON.md (commit 7c459d3)
;   IR emitter:   docs/IR_EMITTER_STUB.md (commit 9106403)
;   Backend note: docs/BACKEND_SELECTION_NOTE.md (commit 9106403)
;
; Non-supersession: this formalization does not alter IR semantics
; or supersede kernel contracts or invariants. It is a downstream
; application of IR_V0 extended to W32 domain.
;
; ============================================================

IR_V0
DOMAIN {W32}        ; 32-bit word = product of 32 boolean lanes

; ── Primitive operations (closed set) ─────────────────────
;
; Each operation is deterministic, finite-state, non-temporal.
; Machine code affinity: each maps 1:1 to a native instruction.

GATE AND32(a: W32, b: W32) -> W32       ; bitwise AND → AND reg, reg
GATE OR32(a: W32, b: W32)  -> W32       ; bitwise OR  → OR  reg, reg
GATE XOR32(a: W32, b: W32) -> W32       ; bitwise XOR → XOR reg, reg
GATE NOT32(a: W32)         -> W32       ; bitwise NOT → NOT reg
GATE SHR32(a: W32, n: IMM) -> W32       ; logical shift right → SHR reg, imm
GATE ROTR32(a: W32, n: IMM) -> W32      ; rotate right → ROR reg, imm
GATE ADD32(a: W32, b: W32) -> W32       ; mod 2^32 add → ADD reg, reg

; Note: ADD32 is modular arithmetic, not accumulation.
; It is a pure function: ADD32(a, b) = (a + b) mod 2^32.
; No carry chain persists across invocations.

; ── SHA-256 round constants (static table) ────────────────
;
; 64 entries, immutable, finite. No runtime mutation.

TABLE K[0..63] -> W32
  0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5
  0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5
  0xd807aa98 0x12835b01 0x243185be 0x550c7dc3
  0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174
  0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc
  0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da
  0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7
  0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967
  0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13
  0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85
  0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3
  0xd192e819 0xd6990624 0xf40e3585 0x106aa070
  0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5
  0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3
  0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208
  0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2
END

; ── SHA-256 initial hash values (static table) ────────────

TABLE H_INIT[0..7] -> W32
  0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a
  0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19
END

; ── Derived operations (composed from primitives) ─────────
;
; Each is a pure function. No state, no side effects.

; SHA-256 σ0 (small sigma 0)
GATE sig0(x: W32) -> W32
  XOR32(XOR32(ROTR32(x, 7), ROTR32(x, 18)), SHR32(x, 3))
END

; SHA-256 σ1 (small sigma 1)
GATE sig1(x: W32) -> W32
  XOR32(XOR32(ROTR32(x, 17), ROTR32(x, 19)), SHR32(x, 10))
END

; SHA-256 Σ0 (big sigma 0)
GATE Sig0(x: W32) -> W32
  XOR32(XOR32(ROTR32(x, 2), ROTR32(x, 13)), ROTR32(x, 22))
END

; SHA-256 Σ1 (big sigma 1)
GATE Sig1(x: W32) -> W32
  XOR32(XOR32(ROTR32(x, 6), ROTR32(x, 11)), ROTR32(x, 25))
END

; SHA-256 Ch (choice)
GATE Ch(e: W32, f: W32, g: W32) -> W32
  XOR32(AND32(e, f), AND32(NOT32(e), g))
END

; SHA-256 Maj (majority)
GATE Maj(a: W32, b: W32, c: W32) -> W32
  XOR32(XOR32(AND32(a, b), AND32(a, c)), AND32(b, c))
END

; ── Message schedule expansion (stages 16..63) ────────────
;
; W[i] = ADD32(ADD32(ADD32(sig1(W[i-2]), W[i-7]), sig0(W[i-15])), W[i-16])
;
; Each W[i] is a static function of W[i-2], W[i-7], W[i-15], W[i-16].
; No loop — 48 static stage definitions (W[16] through W[63]).
; Omitted here for brevity; the lowered C emits all 48 inline.

; ── Compression round (single stage) ─────────────────────
;
; One round takes (a,b,c,d,e,f,g,h, W[i], K[i]) → (a',b',c',d',e',f',g',h')
;
; STAGE round_i(a,b,c,d,e,f,g,h: W32, Wi: W32, Ki: W32) ->
;   (a': W32, b': W32, c': W32, d': W32,
;    e': W32, f': W32, g': W32, h': W32)
;
;   t1 = ADD32(ADD32(ADD32(ADD32(h, Sig1(e)), Ch(e, f, g)), Ki), Wi)
;   t2 = ADD32(Sig0(a), Maj(a, b, c))
;   h' = g
;   g' = f
;   f' = e
;   e' = ADD32(d, t1)
;   d' = c
;   c' = b
;   b' = a
;   a' = ADD32(t1, t2)
;
; 64 stages unrolled. Each stage is a pure function of the previous.
; The full compression is a composition of 64 stage functions.

; ── dsha256 pipeline ──────────────────────────────────────
;
; INPUT:  midstate[0..7]: W32    (from first 64 bytes, pre-computed)
;         tailBlock[0..15]: W32  (last 16 bytes + padding, nonce at [3])
;         nonce: W32
;
; STAGE 1: Byte-swap nonce (LE → BE)
;   swapped = OR32(OR32(OR32(
;     SHR32(AND32(nonce, 0xFF000000), 24),
;     SHR32(AND32(nonce, 0x00FF0000), 8)),
;     SHL32(AND32(nonce, 0x0000FF00), 8)),
;     SHL32(AND32(nonce, 0x000000FF), 24))
;   tailBlock[3] = swapped
;
; STAGE 2: Compression 1 — SHA-256(midstate, tailBlock)
;   state1[0..7] = compress(midstate[0..7], tailBlock[0..15])
;
; STAGE 3: Build round 2 block
;   block2[0..7]  = state1[0..7]
;   block2[8]     = 0x80000000    ; padding marker
;   block2[9..14] = 0x00000000    ; zero padding
;   block2[15]    = 0x00000100    ; bit-length = 256
;
; STAGE 4: Compression 2 — SHA-256(H_INIT, block2)
;   result[0..7] = compress(H_INIT[0..7], block2[0..15])
;
; OUTPUT: result[0..7]: W32
;
; Target rejection: read result[7] first (word-level 1D check).
; If result[7] != 0, reject immediately. No byte conversion needed.

OUTPUT result[0..7]

; ── Machine code affinity ─────────────────────────────────
;
; Every voynich gate maps to exactly one native instruction:
;
;   AND32  → and  eax, ebx       (x86) | and w0, w1, w2   (ARM)
;   OR32   → or   eax, ebx       (x86) | orr w0, w1, w2   (ARM)
;   XOR32  → xor  eax, ebx       (x86) | eor w0, w1, w2   (ARM)
;   NOT32  → not  eax             (x86) | mvn w0, w1       (ARM)
;   SHR32  → shr  eax, imm       (x86) | lsr w0, w1, #imm (ARM)
;   ROTR32 → ror  eax, imm       (x86) | ror w0, w1, #imm (ARM)
;   ADD32  → add  eax, ebx       (x86) | add w0, w1, w2   (ARM)
;
; On x86 with SHA-NI extensions:
;   compress() → sha256rnds2 + sha256msg1 + sha256msg2
;   (4 rounds per instruction, 16 instructions per compression)
;
; On ARM with Crypto extensions:
;   compress() → sha256h + sha256h2 + sha256su0 + sha256su1
;
; The voynich specification IS the machine code, expressed
; in mathematical notation. Lowering requires no semantic
; interpretation layer.

; END OF VOYNICH FORMALIZATION
